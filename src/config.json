{
    "baseUrl": "/",
    "output": "./../",
    "plugins": [
        "wintersmith-nunjucks",
        "wintersmith-markdown-it"
    ],
    "markdown-it": {
        "settings": {
            "html": true,
            "linkify": true,
            "typographer": false
        },
        "markdown-it-attrs": {
            "allowedAttributes": ["id","class"]
        },
        "markdown-it-div": {},
        "markdown-it-anchor": {"tabIndex": false}
    }
}
