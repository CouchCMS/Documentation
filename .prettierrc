{
    "singleQuote": false,
    "proseWrap": "preserve",
    "embeddedLanguageFormatting": "auto",
    "tabWidth": 4,
    "overrides": [
        {
            "files": ["*.md", "*.mdx"],
            "options": {
                "singleQuote": false,
                "printWidth": 120
            }
        }
    ]
}
