# CouchCMS Documentation Editor Config
# Auto-generated from DOCS-STANDARDS.md

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,mdx}]
max_line_length = 80
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_size = 2

[*.{ts,js,mjs}]
indent_size = 2

[package.json]
indent_size = 2
